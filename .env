# Chỉnh ảnh 2x6
PRINT_OFFSET_X=1.69 # Dịch trái phải
PRINT_OFFSET_Y=1.7 # Dịch lên xuống
# Chỉnh ảnh 4x6
PRINT_4X6_OFFSET_X=2
PRINT_4X6_OFFSET_Y=2.2
# Chỉnh ảnh 4x6 Ngang
PRINT_4X6_LANDSCAPE_OFFSET_X=2
PRINT_4X6_LANDSCAPE_OFFSET_Y=2.1

# Cấu hình Tên Máy In (Dùng tên chính xác trong Control Panel)
PRINTER_NAME="DS-RX1 4x6"           # Máy in thường (Khổ 4x6)
PRINTER_NAME_2CUT="DS-RX1 4x6 (2-cut)" # Máy in cắt đôi (Khổ 2x6)

# QR Code Configuration
ENABLE_QR_ON_FRAME=on # on = In mã QR lên ảnh, off = Ẩn mã QR
QR_SIZE_STRIP=92     # QR nhỏ gọn cho khổ 2x6
QR_SIZE_STANDARD=80  # QR nhỏ gọn cho khổ 4x6

# Vị trí QR (0.0 - 1.0)
QR_POS_X_FRACTION=0.04  # Cách mép trái 4%
QR_POS_Y_FRACTION=0.985 # Cách mép trên 98.5% (tức là đáy nằm sát dưới)

CMS_API_URL=http://localhost:3003

PORT=6001

# Skin Smoothing (0-100)
SKIN_SMOOTHING_LEVEL=0

# Tinh chỉnh Hiệu năng Ghép ảnh (Giảm tải CPU)
COMPOSITE_TARGET_RESOLUTION=3600  # Mặc định: 3600 (Chuẩn in 4x6 @ 600dpi). Dùng 3000 để nhanh/nhẹ hơn.
COMPOSITE_JPEG_QUALITY=100         # Mặc định: 92 (Chất lượng cao). Dùng 100 sẽ nặng nhất (xử lý chậm).
COMPOSITE_CHROMA_444=true       # Mặc định: false (Tối ưu tốc độ). True = màu chuẩn tuyệt đối (4:4:4) nhưng chậm.



# Máy đoc tín hieuj ICR
COM_PORT=COM8



# ===================== THONG SO RAP VIDEO =====================
# Toc do rap video (0.5 = tua nhanh x2, 1.0 = binh thuong, 2.0 = cham x2)
VIDEO_SPEED=0.5
# Tự động quay toàn bộ phiên bằng webcam và xuất video timelapse MP4.
TIMELAPSE_ENABLED=true
TIMELAPSE_VIDEO_BITS_PER_SECOND=4000000
# Chat luong nen video (0-51, cang nho cang net nhung nang, 28 la chuan web)
VIDEO_CRF=5

# Camera: mirror chỉ áp dụng cho preview; file lưu/in luôn đúng chiều.
MIRROR_PREVIEW=true
MIRROR_OUTPUT=false
LOCAL_FRAMES_DIR=./frames
BRANDING_NAME=Roti Photobooth
BRANDING_TAGLINE=Giữ lại khoảnh khắc của bạn
