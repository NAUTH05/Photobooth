{
  "name": "mobile-photobooth",
  "version": "0.8.0",
  "private": true,
  "description": "Windows kiosk photobooth with webcam/DSLR bridge and Cloudflare R2 storage",
  "author": "Chạm Photobooth",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build": "npm run build:renderer && npm run build:native",
    "dist:win": "npm run build && electron-builder --win nsis",
    "start": "electron .",
    "test": "npm run build:native && node --test --test-force-exit test/*.test.js",
    "check": "npm run build:renderer && npm test"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "vn.cham.photobooth",
    "productName": "Chạm Photobooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "src/gallery/**/*",
      "config/**/*",
      "native/build/photobooth-camera-bridge.exe",
      "native/build/photobooth-gallery-backend.exe",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frames",
        "to": "frames",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "print_image.ps1"
        ]
      }
    ],
    "asarUnpack": [
      "native/build/photobooth-camera-bridge.exe",
      "native/build/photobooth-gallery-backend.exe",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
